# Copia a .env solo en tu PC. En Railway usa Variables.
DISCORD_TOKEN=
# ID del servidor: activa Modo desarrollador y Copiar ID del servidor.
GUILD_ID=
PREFIX=>
# Opcional: si falta, todo funciona salvo la IA.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
AI_DM_ENABLED=true
REGISTER_SLASH=true
# Railway proporciona RAILWAY_VOLUME_MOUNT_PATH al conectar el volumen.
# La reproducción local y las cargas de Music Center utilizan FFmpeg y FFprobe.
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
# DATA_DIR=./data

# Página de comandos: opcional. Funciona en el MISMO servicio Railway.
WEB_ENABLED=false
# HTTPS, sin barra final ni rutas. Ej.: https://tu-bot.up.railway.app
WEB_BASE_URL=
# Application ID y OAuth2 Client Secret de la MISMA app Discord del bot.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# En Railway se puede fijar 8080 y apuntar el dominio al mismo puerto.
# PORT=8080

# Redirección OAuth2 de Discord a registrar: https://tu-dominio/auth/callback

# Control opcional de dispositivos Spotify. Registra https://tu-dominio/musica/spotify/callback.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Opcional para las utilidades antiguas de catálogo. La voz de Discord utiliza archivos locales.
YOUTUBE_API_KEY=

# Persistencia opcional de memoria v3. Sigue docs/PERSISTENCIA.md antes de activar.
TIMMY_STORAGE=local
# TIMMY_STORAGE=supabase
# TIMMY_SUPABASE_URL=https://tu-proyecto.supabase.co
# TIMMY_SUPABASE_KEY= (secreto de servidor, nunca publicar)
# TIMMY_STORAGE_ID=timmy-produccion
# TIMMY_SUPABASE_BOOTSTRAP=import (solo primera migración; retirar después)

# Permisos opcionales de invitación Discord (entero decimal, sin Administrator).
# Por defecto solicita permisos básicos de lectura/envío. Concede los de módulos según necesidad.
# DISCORD_INVITE_PERMISSIONS=
